<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/edittext_bg"
    android:layout_margin="5dp"
    android:paddingBottom="15dp">

    <ImageView
        android:id="@+id/imageView_resturants"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:clipToOutline="true"
        android:background="@drawable/edittext_bg"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="centerCrop"
        />

    <TextView
        android:id="@+id/textView_resturantName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/imageView_resturants"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:text="Resturant Name"
        android:textColor="@color/black"
        android:textSize="17.5sp"
        android:singleLine="true"
        android:gravity="center"
        android:layout_marginHorizontal="7.5dp"
        />

    <TextView
        android:id="@+id/textView_resturantLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textView_resturantName"
        app:layout_constraintStart_toStartOf="@id/textView_resturantName"
        app:layout_constraintEnd_toEndOf="@id/textView_resturantName"
        android:layout_marginTop="5dp"
        android:text="Resturant Location"
        android:drawableStart="@drawable/ic_location_small"
        android:gravity="center"
        android:drawableTint="#FF5733"
        android:singleLine="true"
        android:drawablePadding="5dp"
        />

    <TextView
        android:id="@+id/textView_resturantRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textView_resturantLocation"
        app:layout_constraintStart_toStartOf="@id/textView_resturantName"
        android:layout_marginTop="5dp"
        android:text="4.9"
        android:drawableStart="@drawable/star_icon"
        android:gravity="center"
        android:drawablePadding="5dp"
        android:textColor="@color/black"

        />

    <TextView
        android:id="@+id/textView_resturantCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textView_resturantLocation"
        app:layout_constraintStart_toEndOf="@id/textView_resturantRating"
        android:layout_marginTop="5dp"
        android:text="(130)"
        android:gravity="center"
        android:drawablePadding="5dp"
        android:textColor="@color/black"
        android:layout_marginStart="10dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>